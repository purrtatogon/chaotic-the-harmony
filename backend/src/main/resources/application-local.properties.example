# Copy to application-local.properties (gitignored) and adjust values.
#
# Run:
#   ./mvnw spring-boot:run -Dspring-boot.run.profiles=demo,local
#
# Why demo,local (in this order)? "demo" activates SeederService and the demo scheduler;
# "local" is last so this file overrides application-demo.properties (e.g. ddl-auto=update
# instead of create-drop, and your machine's JDBC URL).

server.port=8080

# JPA — keep data between restarts while developing
spring.jpa.hibernate.ddl-auto=update
spring.jpa.generate-ddl=true

# PostgreSQL (create database e.g. cthdb on localhost:5432 first)
spring.datasource.url=jdbc:postgresql://localhost:5432/cthdb
spring.datasource.username=postgres
spring.datasource.password=cthdb123herewego

# JWT — generate: openssl rand -base64 48 (same idea as root .env for Compose)
application.security.jwt.secret-key=
application.security.jwt.expiration=86400000

# CORS — browser origins allowed to call the API
app.cors.allowed-origins=http://localhost:5173,http://localhost:3000

# Optional: scheduled UTC reseeds (00:00, 08:00, 16:00). Default follows demo profile (true)
# unless you set false here or export DEMO_SCHEDULED_RESET_ENABLED=false.
# demo.scheduled-reset.enabled=false
