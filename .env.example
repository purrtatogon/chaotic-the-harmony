# Root env for docker-compose. Copy to `.env` and fill in; never commit `.env`.

# ── Demo reset ─────────────────────────────────────────────────────
# Compose (`demo,docker`): `docker` profile wins — cron reseed off unless this is true.
# `demo` only (Railway, Render, cloud): default on — set false to disable.
DEMO_SCHEDULED_RESET_ENABLED=false


# ── PostgreSQL ──────────────────────────────────────────────────────
# `db` container (official image). Same values feed Compose defaults for backend JDBC URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cthdb123herewego
POSTGRES_DB=cthdb


# ── Spring datasource (JAR on host) ───────────────────────────────
# Use localhost when Postgres is mapped to 5432. Compose overrides these for the backend
# service with `jdbc:postgresql://db:5432/...`.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cthdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=cthdb123herewego


# ── JWT ─────────────────────────────────────────────────────────────
# Needed with `docker` and/or `demo` profiles (Compose: both; most hosts: `demo` only).
# Generate: openssl rand -base64 48 — paste unquoted; keep secrets in `.env`/hosting vars only;
# never in git; store a backup in a password manager.
JWT_SECRET_KEY=
JWT_EXPIRATION=86400000

# Browser origins allowed by the API (CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
