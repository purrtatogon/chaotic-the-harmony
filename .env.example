# ── PostgreSQL (Container internal) ─────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password_here
POSTGRES_DB=cthdb

# ── Spring Datasource (Local/Docker) ──────────────────────────────
# When running JAR locally (outside Docker), use localhost:5432
# Compose overrides this for the container network.
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/cthdb
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres_password_here

# ── Security & JWT ──────────────────────────────────────────────────
# Use 'openssl rand -base64 48' to generate a real key for your .env
JWT_SECRET_KEY=
JWT_EXPIRATION=86400000

# ── Application Settings ───────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173